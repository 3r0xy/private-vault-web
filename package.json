{
  "name": "private-vault-web",
  "version": "1.0.0",
  "description": "Luna вЂ” private GitHub vault",
  "private": true,
  "license": "UNLICENSED",
  "main": "app.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "build": "node scripts/build-vendor.mjs",
    "test": "node --test tests/domain.test.mjs",
    "test:login": "node tests/login.test.cjs",
    "test:browser": "node tests/browser.test.cjs",
    "start": "node --env-file-if-exists=.env server/start.mjs",
    "test:oauth": "node --test tests/oauth.test.mjs",
    "test:oauth-browser": "node tests/oauth-browser.test.cjs",
    "test:cloudflare": "node cloudflare/prepare.mjs && node tests/cloudflare-runtime.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3r0xy/private-vault-web.git"
  },
  "keywords": [],
  "author": "",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/3r0xy/private-vault-web/issues"
  },
  "homepage": "https://github.com/3r0xy/private-vault-web#readme",
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "d3": "7.9.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "wrangler": "4.156.0"
  },
  "engines": {
    "node": ">=24"
  }
}
